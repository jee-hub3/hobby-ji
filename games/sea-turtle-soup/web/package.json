{
  "name": "sea-turtle-soup-web",
  "version": "0.1.0",
  "private": true,
  "description": "바다거북 스프 웹 서비스: 정적 페이지 + Cloudflare Worker API (AI 진행자, 게임 상태, 사용량 한도)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "wrangler deploy",
    "test:engine": "node test/engine.test.js",
    "test:e2e": "node test/e2e.js",
    "test": "npm run test:engine && npm run test:e2e && npm run test:budget && npm run test:music && npm run test:motion",
    "eval": "node eval/run.js",
    "test:budget": "node test/budget.js",
    "test:music": "node test/music.js",
    "test:motion": "node test/motion.js",
    "eval:dry": "node eval/run.js --dry",
    "images": "node tools/render-images.js",
    "music:sync": "node tools/sync-music.js",
    "music:render": "node tools/render-music.js",
    "music:analyze": "python3 tools/analyze-music.py",
    "music:check": "node tools/render-music.js --set analysis && python3 tools/analyze-music.py",
    "music:previews": "node tools/render-music.js --set preview --jobs 1 && python3 tools/analyze-music.py --previews music-out/previews",
    "sync": "node tools/sync-modules.js",
    "sync:check": "node tools/sync-modules.js --check",
    "motion:measure": "node tools/measure-motion.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "wrangler": "^4.151.0"
  }
}
